<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_sparkle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvTechQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="Awesome tournament app idea badhiya hai! Chalo iske liye ek detailed prompt banate hain.\n\nPehle yeh batao kis technology stack me banayi jayegi?"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select framework / technology:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Horizontal scroll of tech stack chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutTechChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueTech"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary"
            android:text="Continue with Flutter ➔"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
